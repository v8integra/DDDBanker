{
  "name": "dddbanker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @dddbanker/api\" \"npm run dev -w @dddbanker/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate -w @dddbanker/api",
    "db:seed": "npm run db:seed -w @dddbanker/api",
    "db:reset": "npm run db:reset -w @dddbanker/api",
    "predev": "npm run db:generate -w @dddbanker/api && npm run db:deploy -w @dddbanker/api",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build -w @dddbanker/web && node e2e/run-prod.mjs",
    "start": "npm run start -w @dddbanker/api",
    "db:deploy": "npm run db:deploy -w @dddbanker/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
