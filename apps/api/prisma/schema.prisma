// Bank of Bramblewood data model. All money columns are integer cents (BigInt).
// Datasource URL lives in prisma.config.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  addressLine1      String?
  city              String?
  region            String?
  postalCode        String?
  /// Simulated credit score, assigned at signup (580-820).
  creditScore       Int
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  /// Confirmed two-step verification secret (base32). Null = 2FA off.
  totpSecret        String?
  /// Secret being set up, not yet confirmed with a code.
  totpPendingSecret String?
  createdAt         DateTime  @default(now())

  sessions           Session[]
  accounts           Account[]
  auditLogs          AuditLog[]
  idempotencyRecords IdempotencyRecord[]
  transactions       Transaction[]
  payees             Payee[]
  scheduledPayments  ScheduledPayment[]
  supportTickets     SupportTicket[]
  notifications      Notification[]
  loanApplications   LoanApplication[]
  insuranceQuotes    InsuranceQuote[]
  insurancePolicies  InsurancePolicy[]
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash  String   @unique
  /// Synchronizer token sent back in the X-CSRF-Token header.
  csrfToken  String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  /// Absolute expiry. Idle expiry is lastSeenAt + idle timeout.
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([userId])
}

enum AccountType {
  CHECKING
  SAVINGS
  CD
  CREDIT_CARD
  AUTO_LOAN
  MORTGAGE
  PERSONAL_LOAN
  SYSTEM
}

enum AccountStatus {
  OPEN
  FROZEN
  CLOSED
}

model Account {
  id                     String        @id @default(cuid())
  /// Null for the bank's internal system accounts.
  userId                 String?
  user                   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set only on system accounts, e.g. WELCOME_BONUS.
  systemCode             String?       @unique
  type                   AccountType
  nickname               String
  /// Fake, generated account number.
  number                 String        @unique
  status                 AccountStatus @default(OPEN)
  interestRateBps        Int           @default(0)
  /// Cached sum of this account's ledger entries, updated in the same DB transaction.
  balanceCents           BigInt        @default(0)
  /// CDs only.
  termMonths             Int?
  maturesAt              DateTime?
  /// Credit cards only.
  creditLimitCents       BigInt?
  /// Credit cards: day of month (1-28) statements close.
  statementDay           Int?
  /// Interest earned but not yet paid, in thousandths of a cent (savings and CDs).
  accruedInterestMilli   BigInt        @default(0)
  /// Last bank day interest was accrued for.
  interestAccruedThrough DateTime?
  /// YYYY-MM of the last monthly interest payout.
  interestPostedFor      String?
  closedAt               DateTime?
  createdAt              DateTime      @default(now())

  entries       LedgerEntry[]
  cards         Card[]
  loan          Loan?
  statements    CreditCardStatement[]
  scheduledFrom ScheduledPayment[]    @relation("ScheduledFrom")
  scheduledTo   ScheduledPayment[]    @relation("ScheduledTo")

  @@index([userId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  BILL_PAY
  CARD_PURCHASE
  LOAN_DISBURSEMENT
  LOAN_PAYMENT
  INTEREST
  FEE
  P2P
  WELCOME_BONUS
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

model Transaction {
  id                String            @id @default(cuid())
  type              TransactionType
  description       String
  memo              String?
  /// Where it happened: TELLER, ATM, ONLINE, CARD, SCHEDULED, SYSTEM. Used for channel limits.
  channel           String?
  status            TransactionStatus @default(POSTED)
  initiatedByUserId String?
  initiatedBy       User?             @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  entries LedgerEntry[]

  @@index([initiatedByUserId])
}

model LedgerEntry {
  id                Int         @id @default(autoincrement())
  transactionId     String
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// What this side of the transaction shows on the account's history.
  description       String
  /// Signed: positive adds to the account balance, negative takes from it.
  amountCents       BigInt
  balanceAfterCents BigInt
  createdAt         DateTime    @default(now())

  @@index([accountId, id])
  @@index([transactionId])
}

/// Stored result of a successful money-moving request, keyed per user.
model IdempotencyRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String
  /// SHA-256 of route + request body, so a reused key with a different body is rejected.
  requestHash  String
  statusCode   Int
  responseJson String
  createdAt    DateTime @default(now())

  @@unique([userId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  /// JSON string. Never contains passwords or tokens.
  metadata  String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum CardType {
  DEBIT
  CREDIT
}

enum CardStatus {
  ACTIVE
  LOCKED
  REPORTED_LOST
  REPLACED
}

model Card {
  id                 String     @id @default(cuid())
  accountId          String
  account            Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type               CardType
  last4              String
  expiryMonth        Int
  expiryYear         Int
  status             CardStatus @default(ACTIVE)
  /// Most this card can spend in one bank day.
  spendingLimitCents BigInt     @default(100000)
  /// Set when this card was replaced: the id of the new card.
  replacedById       String?
  createdAt          DateTime   @default(now())

  @@index([accountId])
}

model Payee {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// The account number at the biller (fictional).
  accountRef String
  createdAt  DateTime @default(now())

  scheduledPayments ScheduledPayment[]

  @@index([userId])
}

enum ScheduleFrequency {
  ONCE
  WEEKLY
  MONTHLY
}

model ScheduledPayment {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   Account           @relation("ScheduledFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  /// Exactly one of payeeId / toAccountId is set.
  payeeId       String?
  payee         Payee?            @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  toAccountId   String?
  toAccount     Account?          @relation("ScheduledTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  amountCents   BigInt
  frequency     ScheduleFrequency
  nextRunDate   DateTime
  memo          String?
  active        Boolean           @default(true)
  lastRunAt     DateTime?
  /// Outcome of the last run, e.g. POSTED or INSUFFICIENT_FUNDS.
  lastResult    String?
  createdAt     DateTime          @default(now())

  @@index([active, nextRunDate])
  @@index([userId])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    TicketStatus     @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now())
  messages  SupportMessage[]

  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// CUSTOMER or STAFF.
  author    String
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Small key/value store: the bank clock offset, job progress.
model Setting {
  key   String @id
  value String
}

enum LendingProduct {
  AUTO
  MORTGAGE
  PERSONAL
  CREDIT_CARD
}

enum Decision {
  APPROVED
  DECLINED
  COUNTER_OFFER
}

model LoanApplication {
  id                         String         @id @default(cuid())
  userId                     String
  user                       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product                    LendingProduct
  requestedAmountCents       BigInt
  termMonths                 Int
  /// JSON: income, debts, price, down payment, vehicle year...
  details                    String
  decision                   Decision
  /// Plain-words reason for a decline or counter-offer.
  decisionReason             String?
  offeredAmountCents         BigInt?
  offeredTermMonths          Int?
  offeredRateBps             Int?
  offeredMonthlyPaymentCents BigInt?
  createdAt                  DateTime       @default(now())
  expiresAt                  DateTime
  acceptedAt                 DateTime?
  /// The loan or credit card account opened from this application.
  accountId                  String?

  @@index([userId, createdAt])
}

enum LoanStatus {
  ACTIVE
  PAID_OFF
}

/// Terms of an installment loan. The linked account's balance (negative) is what's owed.
model Loan {
  id                   String         @id @default(cuid())
  accountId            String         @unique
  account              Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  product              LendingProduct
  principalCents       BigInt
  rateBps              Int
  termMonths           Int
  monthlyPaymentCents  BigInt
  startDate            DateTime
  nextDueDate          DateTime
  /// Billed installments not yet paid. Paying more than this goes to principal.
  amountDueCents       BigInt         @default(0)
  installmentsBilled   Int            @default(0)
  autopayFromAccountId String?
  status               LoanStatus     @default(ACTIVE)
  createdAt            DateTime       @default(now())
}

model CreditCardStatement {
  id                    String   @id @default(cuid())
  accountId             String
  account               Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodStart           DateTime
  periodEnd             DateTime
  /// Owed at close, as a positive number.
  statementBalanceCents BigInt
  minimumDueCents       BigInt
  dueDate               DateTime
  interestCents         BigInt   @default(0)
  feeCents              BigInt   @default(0)
  createdAt             DateTime @default(now())

  @@unique([accountId, periodEnd])
}

enum InsuranceType {
  AUTO
  HOME
  RENTERS
  LIFE
}

model InsuranceQuote {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                InsuranceType
  /// JSON of what was asked (vehicle year, home value, coverage level...).
  details             String
  coverageCents       BigInt
  monthlyPremiumCents BigInt
  createdAt           DateTime      @default(now())
  expiresAt           DateTime
  boundAt             DateTime?

  policy InsurancePolicy?

  @@index([userId])
}

enum PolicyStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

model InsurancePolicy {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteId             String         @unique
  quote               InsuranceQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type                InsuranceType
  number              String         @unique
  coverageCents       BigInt
  monthlyPremiumCents BigInt
  status              PolicyStatus   @default(ACTIVE)
  payFromAccountId    String
  nextPremiumDate     DateTime
  createdAt           DateTime       @default(now())
  cancelledAt         DateTime?

  @@index([userId])
  @@index([status, nextPremiumDate])
}
